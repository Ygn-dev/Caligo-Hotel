	"nodes": [
		{
			"nodeId": 0,
			"personaje": "Monologo",
			"text": "Un teléfono.\nPero no sé cómo llamar a RECEPCIÓN.",
			"nextNodeId": 1
		},
		{
			"nodeId": 1,
			"personaje": "SiluetaMujer",
			"text": "Hola…",
			"nextNodeId": 2
		},
		{
			"nodeId": 2,
			"personaje": "Monologo",
			"text": "Una voz suave, a través de mucha interferencia.\nQuizá alguién olvidó colgar antes.",
			"nextNodeId": 3
		},
		{
			"nodeId": 3,
			"personaje": "Personaje",
			"text": "¿Hola? ¿Quién es?",
			"nextNodeId": 4
		},
		{
			"nodeId": 4,
			"personaje": "SiluetaMujer",
			"text": "Está bien. Dime qué sucede.",
			"nextNodeId": 5
		},
		{
			"nodeId": 5,
			"personaje": "Monologo",
			"text": "Distingo un suspiro a través del ruido.\nDebe trabajar aquí.\n\nLa voz más cansada del mundo.",
			"nextNodeId": 6
		},
		{
			"nodeId": 6,
			"personaje": "Personaje",
			"text": "Señorita, comuníqueme con su -",
			"nextNodeId": 7
		},
		{
			"nodeId": 7,
			"personaje": "Monologo",
			"text": "¿La conozco?\nSuave, a pesar del cansacio, y quizás familiar.\nSiento que la conozco.",
			"nextNodeId": 8
		},
		{
			"nodeId": 8,
			"personaje": "SiluetaMujer",
			"text": "Lo sé.\n\nPero se va a sentir diferente después.",
			"nextNodeId": 9
		},
		{
			"nodeId": 9,
			"personaje": "Monologo",
			"text": "Se me cierra la garganta.\nOigo su respiración a través del crujir\npor unos segundos.",
			"nextNodeId": 10
		},
		{
			"nodeId": 10,
			"personaje": "Personaje",
			"text": "Perdón. ¿Diferente? ¿Me conoce?",
			"nextNodeId": 11
		},
		{
			"nodeId": 11,
			"personaje": "SiluetaMujer",
			"text": "Ya no. Lo lamento.",
			"nextNodeId": 12
		},
		{
			"nodeId": 12,
			"personaje": "Monologo",
			"text": "Su voz resiste de quebrarse.\nCreo que ella siempre fue así.",
			"nextNodeId": 13
		},
		{
			"nodeId": 13,
			"personaje": "Personaje",
			"text": "Estoy... demasiado confundido.",
			"nextNodeId": 14
		},
		{
			"nodeId": 14,
			"personaje": "SiluetaMujer",
			"text": "Espero que todo salga bien para ti.\nDe verdad lo deseo.",
			"nextNodeId": 15
		},
		{
			"nodeId": 15,
			"personaje": "Personaje",
			"text": "¿De qué está hablando?\nSeñorita, ¿me escucha?",
			"nextNodeId": 16
		},
		{
			"nodeId": 16,
			"personaje": "Monologo",
			"text": "Creo que no.",
			"nextNodeId": 17
		},
		{
			"nodeId": 17,
			"personaje": "SiluetaMujer",
			"text": "Cuídate mucho.\nPero, por favor...",
			"nextNodeId": 18
		},
		{
			"nodeId": 18,
			"personaje": "SiluetaMujer",
			"text": "... No vuelvas a llamar.",
			"nextNodeId": 19
		},
		{
			"nodeId": 19,
			"personaje": "Personaje",
			"text": "¿Qué? No, no, no.\n\n¡ESPERE!",
			"nextNodeId": 20
		},
		{
			"nodeId": 20,
			"personaje": "Monologo",
			"text": "Maldición...\n\nCortó la llamada.",
			"nextNodeId": 21
		},
		{
			"nodeId": 21,
			"personaje": "Monologo2",
			"text": "¿Por qué me siento tan -",
			"nextNodeId": 22
		},
		{
			"nodeId": 22,
			"personaje": "Monologo2",
			"text": "¿Quién eres?",
